    "/api/messages/{id}/mark_as_read/": {
      "patch": {
        "tags": ["Messages"],
        "summary": "Mark message as read",
        "description": "Marks a message as read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the message to mark as read",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Message marked as read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "message marked as read"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Message not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "example": "adminpass123"
          }
        }
      },
      "JWTResponse": {
        "type": "object",
        "properties": {
          "access": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "refresh": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "Trip": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique trip ID"
          },
          "title": {
            "type": "string",
            "description": "Title of the trip"
          },
          "slug": {
            "type": "string",
            "description": "URL-friendly slug"
          },
          "shortDescription": {
            "type": "string",
            "description": "Brief description of the trip"
          },
          "fullDescription": {
            "type": "string",
            "description": "Detailed description of the trip"
          },
          "duration": {
            "type": "string",
            "description": "Duration of the trip (e.g., '1 Day')"
          },
          "price": {
            "type": "number",
            "format": "decimal",
            "description": "Price of the trip"
          },
          "image": {
            "type": "string",
            "description": "URL to the main trip image"
          },
          "category": {
            "type": "string",
            "description": "Category of the trip (e.g., 'Adventure', 'Cultural')"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Key highlights of the trip"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          }
        }
      },
      "TripDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Trip"
          },
          {
            "type": "object",
            "properties": {
              "timeline": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TimelineItem"
                },
                "description": "Trip timeline details"
              },
              "gallery": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TripImage"
                },
                "description": "Trip gallery images"
              }
            }
          }
        ]
      },
      "TripCreate": {
        "type": "object",
        "required": ["title", "shortDescription", "fullDescription", "duration", "price", "category", "image"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Title of the trip"
          },
          "shortDescription": {
            "type": "string",
            "description": "Brief description of the trip"
          },
          "fullDescription": {
            "type": "string",
            "description": "Detailed description of the trip"
          },
          "duration": {
            "type": "string",
            "description": "Duration of the trip (e.g., '1 Day')"
          },
          "price": {
            "type": "number",
            "format": "decimal",
            "description": "Price of the trip"
          },
          "category": {
            "type": "string",
            "description": "Category of the trip"
          },
          "image": {
