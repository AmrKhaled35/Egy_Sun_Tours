{
  "openapi": "3.0.0",
  "info": {
    "title": "Egy Sun Tours API",
    "description": "API for managing tours, gallery, reviews, and contact information for Egy Sun Tours",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@egyptours.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Development server"
    },
    {
      "url": "https://api.egyptours.com",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Authentication operations"
    },
    {
      "name": "Trips",
      "description": "Operations related to tours and trips"
    },
    {
      "name": "Gallery",
      "description": "Operations related to media gallery"
    },
    {
      "name": "Reviews",
      "description": "Operations related to customer reviews"
    },
    {
      "name": "Contact",
      "description": "Operations related to contact information"
    },
    {
      "name": "Messages",
      "description": "Operations related to contact messages"
    }
  ],
  "paths": {
    "/api/token/": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login to get JWT tokens",
        "description": "Authenticate with username and password to get JWT access and refresh tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JWTResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/token/refresh/": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Refresh JWT access token",
        "description": "Use refresh token to get a new access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refresh"],
                "properties": {
                  "refresh": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully refreshed token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access": {
                      "type": "string",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid refresh token"
          }
        }
      }
    },
    "/api/trips/": {
      "get": {
        "tags": ["Trips"],
        "summary": "Get all trips",
        "description": "Retrieves a list of all trips",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "example": 10
                    },
                    "next": {
                      "type": "string",
                      "nullable": true,
                      "example": "http://localhost:8000/api/trips/?page=2"
                    },
                    "previous": {
                      "type": "string",
                      "nullable": true,
                      "example": null
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Trip"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Trips"],
        "summary": "Create a new trip",
        "description": "Creates a new trip with optional timeline and gallery images",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/TripCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Trip created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/trips/{id}/": {
      "get": {
        "tags": ["Trips"],
        "summary": "Get trip details",
        "description": "Retrieves detailed information about a specific trip including timeline and gallery",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the trip",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripDetail"
                }
              }
            }
          },
          "404": {
            "description": "Trip not found"
          }
        }
      },
      "put": {
        "tags": ["Trips"],
        "summary": "Update a trip",
        "description": "Updates an existing trip",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the trip to update",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/TripUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trip updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Trip not found"
          }
        }
      },
      "delete": {
        "tags": ["Trips"],
        "summary": "Delete a trip",
        "description": "Deletes a trip",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the trip to delete",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Trip deleted successfully"
          },
          "404": {
            "description": "Trip not found"
          }
        }
      }
    },
    "/api/trips/{id}/add_timeline_item/": {
      "post": {
        "tags": ["Trips"],
        "summary": "Add timeline item",
        "description": "Adds a timeline item to an existing trip",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the trip",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/TimelineItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Timeline item added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimelineItem"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Trip not found"
          }
        }
      }
    },
    "/api/trips/{id}/add_gallery_image/": {
      "post": {
        "tags": ["Trips"],
        "summary": "Add gallery image",
        "description": "Adds an image to a trip's gallery",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the trip",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Gallery image file"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Gallery image added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripImage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Trip not found"
          }
        }
      }
    },
    "/api/gallery/": {
      "get": {
        "tags": ["Gallery"],
        "summary": "Get all gallery items",
        "description": "Retrieves a list of all gallery items with optional filtering",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Filter by category",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filter by type (image or video)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["image", "video"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "next": {
                      "type": "string",
                      "nullable": true
                    },
                    "previous": {
                      "type": "string",
                      "nullable": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GalleryItem"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Gallery"],
        "summary": "Create a gallery item",
        "description": "Creates a new gallery item",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/GalleryItemCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Gallery item created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GalleryItem"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/gallery/{id}/": {
      "delete": {
        "tags": ["Gallery"],
        "summary": "Delete a gallery item",
        "description": "Deletes a gallery item",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the gallery item to delete",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Gallery item deleted successfully"
          },
          "404": {
            "description": "Gallery item not found"
          }
        }
      }
    },
