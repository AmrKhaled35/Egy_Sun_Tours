          },
          "404": {
            "description": "Review not found"
          }
        }
      }
    },
    "/api/contact/": {
      "get": {
        "tags": ["Contact"],
        "summary": "Get contact info",
        "description": "Retrieves the contact information",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/contact/{id}/": {
      "put": {
        "tags": ["Contact"],
        "summary": "Update contact info",
        "description": "Updates the contact information",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the contact info (always 1)",
            "required": true,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactInfoUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contact info updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Contact info not found"
          }
        }
      }
    },
    "/api/messages/": {
      "get": {
        "tags": ["Messages"],
        "summary": "Get all messages",
        "description": "Retrieves a list of all contact messages",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "next": {
                      "type": "string",
                      "nullable": true
                    },
                    "previous": {
                      "type": "string",
                      "nullable": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ContactMessage"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Messages"],
        "summary": "Send a message",
        "description": "Sends a new contact message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactMessageCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactMessage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/messages/{id}/": {
      "get": {
        "tags": ["Messages"],
        "summary": "Get message details",
        "description": "Retrieves a specific contact message",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the message",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactMessage"
                }
              }
            }
          },
          "404": {
            "description": "Message not found"
          }
        }
      },
      "delete": {
        "tags": ["Messages"],
        "summary": "Delete a message",
        "description": "Deletes a contact message",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the message to delete",
            "required": true,
            "schema": {
              "type": "integer"
            }
