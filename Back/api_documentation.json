        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the review",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Review"
                }
              }
            }
          },
          "404": {
            "description": "Review not found"
          }
        }
      },
      "put": {
        "tags": ["Reviews"],
        "summary": "Update a review",
